{
  "name": "crocui",
  "version": "1.0.0",
  "description": "CroC UI - Modern file transfer GUI for croc",
  "author": "CroC UI",
  "homepage": "https://github.com/croc",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win portable",
    "build:win:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.croc.ui",
    "productName": "CroC UI",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "splashImage": "assets/splash.bmp"
    }
  }
}